# Local app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# Supabase (use publishable key in browser; never expose a secret/service key)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
WORKFLOW_HMAC_SECRET=
# Optional only during a zero-downtime rotation. Remove after all callers use the active secret.
WORKFLOW_HMAC_PREVIOUS_SECRET=
WORKFLOW_SIGNATURE_TOLERANCE_SECONDS=300
USER_API_RATE_LIMIT_REQUESTS=60
USER_API_RATE_LIMIT_WINDOW_SECONDS=60
INTERNAL_API_RATE_LIMIT_REQUESTS=600
INTERNAL_API_RATE_LIMIT_WINDOW_SECONDS=60
# Keep each RSS orchestration batch lean and bounded; allowed range is 1-20.
RSS_ITEMS_PER_FEED_PER_RUN=1

# Signed n8n workflow callbacks
N8N_WEBHOOK_BASE_URL=http://localhost:5678
# Server-only n8n Public API access for WF-10 execution recovery.
N8N_API_URL=http://localhost:5678
N8N_API_KEY=

# Task-based model aliases
AI_PROVIDER=fake
OPENAI_API_KEY=
AI_MODEL_EXTRACT=gpt-5.6-luna
AI_MODEL_SCORE=gpt-5.6-terra
AI_MODEL_RESEARCH=gpt-5.6-terra
AI_MODEL_WRITE=gpt-5.6-terra
AI_MODEL_VERIFY=gpt-5.6-terra
AI_MODEL_IMAGE=gpt-image-2
AI_RESEARCH_REASONING_EFFORT=low
AI_WRITE_REASONING_EFFORT=low

# Cost and source limits
AI_DAILY_BUDGET_USD=10
AI_PER_RUN_BUDGET_USD=1
AI_INPUT_USD_PER_1M=0
AI_OUTPUT_USD_PER_1M=0
AI_WEB_SEARCH_USD_PER_CALL=0
AI_RESEARCH_MAX_QUERIES=3
AI_RESEARCH_MAX_DOMAINS=12
AI_RESEARCH_MAX_RESULTS=20
AI_RESEARCH_TIMEOUT_MS=60000
AI_RESEARCH_MAX_OUTPUT_TOKENS=5000
AI_WRITE_MAX_OUTPUT_TOKENS=4000
AI_WRITE_TIMEOUT_MS=60000
AI_WRITE_PER_RUN_BUDGET_USD=0.5
AI_IMAGE_QUALITY=low
AI_IMAGE_SIZE=1536x1024
AI_IMAGE_TIMEOUT_MS=120000
# Current approved test ceiling for one low-quality GPT Image 2 landscape output.
AI_IMAGE_COST_USD_PER_IMAGE=0.005
AI_IMAGE_PER_RUN_BUDGET_USD=0.01
AI_PROVIDER_MAX_RETRIES=2
# Required before AI_PROVIDER=openai; identify the accepted live eval reports.
AI_RESEARCH_EVAL_BASELINE_ID=
AI_EDITORIAL_EVAL_BASELINE_ID=
AI_IMAGE_EVAL_BASELINE_ID=
MAX_SOURCE_BYTES=10485760
MAX_PDF_PAGES=100
