{
  "name": "ai-social-content-engine",
  "version": "1.0.0-lightweight-rc.1",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "typecheck": "turbo run typecheck",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e",
    "sheet:build": "node scripts/build-team-input-register.mjs",
    "runtime:preflight": "node scripts/check-runtime-bridge.mjs --remote",
    "n8n:plan": "node scripts/publish-n8n-workflows.mjs",
    "n8n:publish": "node scripts/publish-n8n-workflows.mjs --apply --publish",
    "n8n:lightweight:plan": "node scripts/publish-n8n-workflows.mjs --profile=lightweight",
    "n8n:lightweight:import": "node scripts/publish-n8n-workflows.mjs --profile=lightweight --apply"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@playwright/test": "1.61.1",
    "@types/node": "24.1.0",
    "detect-libc": "2.1.2",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "supabase": "2.109.1",
    "tar": "7.4.3",
    "turbo": "2.5.5",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0",
    "vitest": "3.2.4"
  }
}
